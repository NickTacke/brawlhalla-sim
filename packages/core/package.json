{
  "name": "@brawlhalla-sim/core",
  "version": "0.0.1",
  "description": "Deterministic Brawlhalla simulation core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@brawlhalla-sim/replay-format": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickTacke/brawlhalla-sim.git",
    "directory": "packages/core"
  },
  "license": "MIT"
}
